# Application settings
app: {
    name: "My Service"
    version: "1.2.3"
    debug: false
}

# Server section
server: {
    host: "0.0.0.0"
    port: 8080
    retry_attempts: 3
}

# Database connection
db: {
    host: "db.example.local"
    port: 3306
    username: "user"
    password: "pass"
    ssl: true
}

# Simple arrays
valid_ports: [
    80
    443
]

# Invalid examples:
# - Single-line arrays are forbidden
invalid_single_line: [80 443]

# - Array elements MUST have the same type
invalid_mixed_types: [
    80
    "443"
]