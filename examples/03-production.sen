/*
 * SEN Production Configuration
 * High-performance API Service
 * Version: 2.4.12-release
 */

# Global Application Settings
app: {
    name: "Enterprise Core API"
    version: "2.4.12"
    environment: "production"
    debug: false
    maintenance_mode: false
}

# Security & Authentication Cluster
security: {
    jwt: {
        secret: "super-secret-random-key-64-chars"
        expires_in: 3600
        refresh_ttl: 86400
        algorithm: "HS256"
    }
    hashing: {
        driver: "argon2id"
        memory_cost: 65536
        threads: 4
    }
    cors: {
        allowed_origins: [
            "https://app.example.com"
            "https://admin.example.com"
            "https://api.example.com"
        ]
        allow_credentials: true
    }
}

# Distributed Database Configuration
database: {
    driver: "postgresql"
    
    # Primary Write Node
    primary: {
        host: "db-master.cluster.internal"
        port: 5432
        name: "main_prod_db"
        user: "db_admin"
        password: "secure_password_here"
    }
    
    # Read-only Replicas
    replicas: [
        {
            host: "db-replica-01.internal"
            port: 5432
        }
        {
            host: "db-replica-02.internal"
            port: 5432
        }
    ]
    
    # Connection Pool settings
    pool: {
        max_connections: 50
        min_idle: 10
        timeout_seconds: 30.5
    }
}

# Redis Cache Cluster
cache: {
    provider: "redis"
    url: "redis://cache.internal:6379"
    prefix: "api_v2_cache_"
    default_ttl: 1800
}

# External Services Integration
services: {
    # Email via SMTP/SendGrid
    mail: {
        host: "smtp.sendgrid.net"
        port: 587
        username: "apikey"
        encryption: "tls"
    }
    
    # S3 Storage for assets
    storage: {
        provider: "aws_s3"
        bucket: "prod-assets-static"
        region: "us-east-1"
        use_cdn: true
    }
}

# Monitoring & Logging (Sentry / Datadog)
monitoring: {
    log_level: "error"
    sentry_dsn: "https://token@o1234.ingest.sentry.io/5678"
    metrics_enabled: true
    sample_rate: 0.1
}

# Infrastructure Limits
rate_limit: {
    enabled: true
    requests_per_minute: 1000
    burst: 50
}

# Feature Flags for Rollout
features: {
    new_billing_engine: false
    beta_search_v3: true
    v2_ui_experimental: false
}

# Metadata for Deployment (Null value example)
deployment_tag: null